# 복사해서 .env 로 저장하세요. 실제 키는 절대 커밋하지 마세요(.env 는 .gitignore 에 포함).

# 검색 방식: auto(의미 검색 가능하면 하이브리드) | bm25(키워드 검색만, 메모리 약 100MB)
# Render Free 에서는 bm25 를 사용하세요.
RETRIEVAL_BACKEND=bm25

# 선택: AI 요약(Gemini). 둘 다 설정해야 켜지며, 비워 두면 자료 원문 발췌로 답합니다.
GEMINI_API_KEY=
GEMINI_MODEL=

# 선택(과거 기능): OpenAI 는 현재 앱에서 사용하지 않습니다.
# OPENAI_API_KEY=
